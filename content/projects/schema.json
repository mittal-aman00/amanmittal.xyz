{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project entry",
  "description": "One project card. Save as content/projects/<slug>.json (not starting with _). Copy from _template.json.",
  "type": "object",
  "required": ["name", "description", "image", "repo"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Points at ./schema.json so the editor can validate this file."
    },
    "name": {
      "type": "string",
      "description": "Project title, shown as the card heading.",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "description": "Optional one-liner under the title."
    },
    "description": {
      "type": "string",
      "description": "Short paragraph. Two to three sentences reads best.",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "description": "Path under public/, e.g. /images/projects/my-project.png. Landscape 16:9.",
      "pattern": "^/images/.+\\.(png|jpg|jpeg|webp|avif|svg)$"
    },
    "repo": {
      "type": "string",
      "description": "Full GitHub repository URL.",
      "pattern": "^https://github\\.com/.+"
    },
    "demo": {
      "type": "string",
      "description": "Optional live URL. Omit the field if there is no demo."
    },
    "tags": {
      "type": "array",
      "description": "Technology chips on the card.",
      "items": { "type": "string" }
    },
    "featured": {
      "type": "boolean",
      "description": "Featured projects are listed first."
    }
  }
}

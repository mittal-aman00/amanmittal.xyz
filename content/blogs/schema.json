{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blog entry",
  "description": "One Medium article card. Save as content/blogs/<slug>.json (not starting with _). Copy from _template.json.",
  "type": "object",
  "required": ["title", "url", "date", "excerpt"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Points at ./schema.json so the editor can validate this file."
    },
    "title": {
      "type": "string",
      "description": "Article title on the card.",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "description": "Full Medium article URL.",
      "format": "uri"
    },
    "date": {
      "type": "string",
      "description": "Publish date as YYYY-MM-DD.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "excerpt": {
      "type": "string",
      "description": "One or two sentences under the title.",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "description": "Optional topic chips.",
      "items": { "type": "string" }
    },
    "readingTime": {
      "type": "string",
      "description": "Optional, e.g. \"6 min read\"."
    }
  }
}

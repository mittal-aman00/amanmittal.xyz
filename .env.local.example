# Copy this file to .env.local and fill in your EmailJS credentials.
# Dashboard: https://dashboard.emailjs.com
# These are server-only (no NEXT_PUBLIC_) — used by /api/contact.

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Required when Account → Security has "Use Private Key" enabled:
EMAILJS_PRIVATE_KEY=

# Your EmailJS template must use these variable names:
#   {{name}}   {{mail}}   {{message}}   {{reply_to}}
# (name = visitor name, mail = visitor email, reply_to = same as mail)

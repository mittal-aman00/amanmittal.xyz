# Copy this file to .env.local and fill in your EmailJS credentials.
# Dashboard: https://dashboard.emailjs.com
# These are server-only (no NEXT_PUBLIC_) — used by /api/contact.

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Your EmailJS template must use these variable names, which match the
# form field names in src/components/ContactForm.tsx:
#   {{from_name}}   {{from_email}}   {{message}}
